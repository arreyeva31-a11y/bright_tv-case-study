-block.active { color: rgb(77, 77, 77); }

.block { display: block; }

.full-size { width: 100%; height: 100%; }

.paragraph { margin: 23px 0px 10px; }

body.app-loading { background-color: var(--colors-background-neutrals-press=
ed); }

.no-display { display: none !important; }

.pull-left { float: left !important; }

.pull-right { float: right !important; }

.hiddenFileForm { width: 0px; height: 0px; }

.hiddenFileInput { display: none; width: 0px; height: 0px; }

.plugins_sandbox_iframe { position: absolute; top: -10000px; left: -10000px=
; }
