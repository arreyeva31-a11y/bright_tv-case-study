idth: 100%; overflow: hidden; text-overflow: ellipsis; vertical-align: text=
-bottom; color: var(--colors-text-neutrals); }

.rtb-select__button .rtb-select__button-text img { width: 36px; height: 36p=
x; min-width: 36px; max-width: 36px; min-height: 36px; max-height: 36px; ov=
erflow: hidden; }

.rtb-select__options-wrapper { position: absolute; z-index: 200; min-width:=
 calc(100% - 4px); margin: 4px 0px; padding: 4px 4px 4px 0px; box-shadow: r=
gba(5, 0, 56, 0.12) 0px 4px 16px; border-radius: 4px; user-select: none; tr=
ansition-property: opacity; transition-duration: 0.2s; background-color: va=
r(--colors-background-neutrals); }

.rtb-select__options-wrapper:focus { outline: none; }

.rtb-select__options-wrapper.rtb-select__options-wrapper--popper { position=
: relative; }

.rtb-select__options-wrapper.ng-enter, .rtb-select__options-wrapper.ng-ente=
r-prepare, .rtb-select__options-wrapper.ng-leave.ng-leave-active { opacity:=
 0; }

.rtb-select__options-wrapper.ng-leave, .rtb-select__options-wrapper.ng-ente=
r.ng-enter-active { opacity: 1; }

.rtb-select--fit-options .rtb-select__options-wrapper { width: 100%; }

.rtb-select__options { overflow: hidden auto; width: 100%; max-height: 33vh=
; box-sizing: border-box; margin: 0px; padding: 4px 4px 4px 0px; list-style=
-type: none; }

.rtb-select__options.rtb-select__options--no-scroll { overflow: hidden; }

.rtb-select__options.rtb-select__options--virtual { max-height: initial; }

.rtb-select__options:not(.rtb-select__options--no-scroll), .rtb-select__opt=
ions .rtb-select__options-scroll { scrollbar-color: var(--colors-gray-250) =
transparent; scrollbar-width: thin; }

.rtb-select__options:not(.rtb-select__options--no-scroll)::-webkit-scrollba=
r, .rtb-select__options .rtb-select__options-scroll::-webkit-scrollbar { wi=
dth: 4px; height: 4px; }

.rtb-select__options:not(.rtb-select__options--no-scroll)::-webkit-scrollba=
r-thumb, .rtb-select__options .rtb-select__options-scroll::-webkit-scrollba=
r-thumb { background-color: var(--colors-gray-250); border: 0px solid trans=
parent; border-radius: 2px; }

.rtb-select__options:not(.rtb-select__options--no-scroll)::-webkit-scrollba=
r-track, .rtb-select__options .rtb-select__options-scroll::-webkit-scrollba=
r-track { background-color: initial; }

.rtb-select__options .rtb-select__option:focus-visible { box-shadow: inset =
0 0 0 1px var(--colors-blue-500), 0 0 0 1px var(--colors-blue-500), 0 0 0 5=
px var(--colors-blue-200); }

.rtb-select--large .rtb-select__options { padding-left: 20px; }

.rtb-select--large .rtb-select__options .rtb-select__option { height: 60px;=
 line-height: 60px; font-size: 20px; }

.rtb-select--medium .rtb-select__options { padding-left: 16px; }

.rtb-select--medium .rtb-select__options .rtb-select__option { height: 32px=
; line-height: 32px; font-size: 16px; padding-right: 40px; }

.rtb-select--xsmall .rtb-select__options { padding-left: 14px; }

.rtb-select--xsmall .rtb-select__options .rtb-select__option { height: 32px=
; line-height: 32px; font-size: 14px; }

