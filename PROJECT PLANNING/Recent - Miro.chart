.rtb-select--small .rtb-select__options .rtb-select__option { height: 36px;=
 line-height: 36px; font-size: 14px; }

.rtb-select--menu .rtb-select__options { min-width: 200px; padding: 12px 4p=
x 12px 16px; }

.rtb-select--menu .rtb-select__options .rtb-select__option { padding: 0px 1=
2px 0px 8px; height: 36px; line-height: 36px; font-size: 14px; }

.rtb-select__options--non-scrollable { max-height: none; }

.rtb-select__option--with-text { margin-top: 10px; color: var(--colors-text=
-primary); }

.rtb-select__option { display: flex; align-items: center; width: 100%; padd=
ing: 0px; text-align: left; cursor: pointer; white-space: nowrap; }

.rtb-select__option.rtb-select__option--locked { white-space: normal; }

.rtb-select__option:not(.rtb-select__option--disabled, [disabled]):hover, .=
rtb-select__option:focus, .rtb-select__option.rtb-select__option--focused, =
.rtb-select__option.rtb-select__option--selected { color: var(--colors-text=
-primary-selected); }

