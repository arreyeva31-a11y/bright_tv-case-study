@charset "utf-8";

@keyframes spinner {=20
  100% { transform: rotate(360deg); }
}

.structuredDocument { transform: rotate(0deg); }

.structuredDocument .ql-container { zoom: calc(1 / var(--a11yZoomScale, 1))=
; }

.structuredDocument .ql-editor { width: 100%; flex-grow: 1; padding: var(--=
ql-padding-top) var(--ql-padding-right) var(--ql-padding-bottom) var(--ql-p=
adding-left); outline: none; tab-size: 4; text-align: left; box-sizing: bor=
der-box; height: 100%; overflow: hidden; user-select: text; white-space: pr=
e-wrap; font-size: inherit; color: var(--colors-text-neutrals); caret-color=
: var(--struct-doc-caret-color); }

.structuredDocument .ql-editor p, .structuredDocument .ql-editor li, .struc=
turedDocument .ql-editor pre, .structuredDocument .ql-editor h1, .structure=
dDocument .ql-editor h2, .structuredDocument .ql-editor blockquote { positi=
on: relative; }

.structuredDocument .ql-editor p, .structuredDocument .ql-editor ol, .struc=
turedDocument .ql-editor ul, .structuredDocument .ql-editor pre, .structure=
dDocument .ql-editor h1, .structuredDocument .ql-editor h2 { margin: 0px; p=
adding: 0px; }

.structuredDocument .ql-editor p, .structuredDocument .ql-editor ol, .struc=
turedDocument .ql-editor ul, .structuredDocument .ql-editor pre { --line-he=
ight: 22px; line-height: var(--line-height); }

.structuredDocument .ql-editor p { padding: 4px; }

.structuredDocument .ql-editor img { user-select: auto !important; }

.structuredDocument .ql-editor h1 { --line-height: 34px; font-size: 24px; f=
ont-weight: 600; line-height: var(--line-height); margin: 0px; padding: 20p=
x 4px 4px; }

.structuredDocument .ql-editor h2 { --line-height: 26px; font-size: 20px; f=
ont-weight: 600; line-height: var(--line-height); margin: 0px; padding: 20p=
x 4px 4px; }

.structuredDocument .ql-editor h3 { --line-height: 20px; font-size: 16px; f=
ont-weight: 600; line-height: var(--line-height); margin: 0px; padding: 20p=
x 4px 4px; }

.structuredDocument .ql-editor h1:first-child, .structuredDocument .ql-edit=
or h2:first-child, .structuredDocument .ql-editor h3:first-child, .structur=
edDocument .ql-editor ol:first-child li:first-child, .structuredDocument .q=
l-editor ul:first-child li:first-child, .structuredDocument .ql-editor p:fi=
rst-child { padding-top: 0px; }

.structuredDocument .ql-editor code { background-color: var(--colors-backgr=
ound-neutrals-subtle); border-radius: 4px; box-sizing: border-box; padding:=
 1px 1px 0px; margin: 0px -1px; line-height: calc(0.8 * var(--line-height))=
; position: relative; top: 0px; font-size: 0.8em; font-family: "Roboto Mono=
", monospace; white-space: pre-wrap; overflow-wrap: break-word; word-break:=
 normal; display: inline; box-decoration-break: clone; box-shadow: inset 0 =
0 0 1px var(--colors-gray-300) !important; }

.structuredDocument .ql-editor :is(h1, h2) code { top: -1px; }

.structuredDocument .ql-editor blockquote { --padding-vert: 20px; margin: 0=
px; padding: var(--padding-vert) 4px var(--padding-vert) 32px; line-height:=
 22px; }

.structuredDocument .ql-editor blockquote.ql-placeholders-item { margin-lef=
t: 0px; }

.structuredDocument .ql-editor blockquote:not(.ql-placeholders-item)::befor=
e { position: absolute; display: block; height: calc(100% - 4px - var(--pad=
ding-vert) * 2); left: 4px; content: ""; border: 2px solid var(--colors-ico=
n-neutrals-subtle); border-radius: var(--radii-50); }

.structuredDocument .ql-editor [data-callout-color] { padding-top: var(--ca=
llout-margin-top); padding-bottom: var(--callout-margin-bottom); padding-le=
ft: var(--callout-margin-left); padding-right: var(--callout-margin-right);=
