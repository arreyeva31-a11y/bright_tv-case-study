.rtb-material-spinner { position: relative; margin: 0px auto; width: 40px; =
overflow: hidden; }

.rtb-material-spinner::before { content: ""; display: block; padding-top: 1=
00%; }

.rtb-material-spinner-circular { animation: 2s linear 0s infinite normal no=
ne running rotate; height: 100%; transform-origin: center center; width: 10=
0%; position: absolute; inset: 0px; margin: auto; }

.rtb-material-spinner-path { stroke-dasharray: 1, 200; stroke-dashoffset: 0=
; animation: 1.5s ease-in-out 0s infinite normal none running dash; stroke-=
linecap: round; stroke: var(--colors-blue-500); }

.rtb-material-spinner--white .rtb-material-spinner-path { stroke: var(--col=
ors-white); stroke-width: 4; }

@keyframes rotate {=20
  100% { transform: rotate(360deg); }
}

@keyframes dash {=20
  0% { stroke-dasharray: 1, 200; stroke-dashoffset: 0; }
  50% { stroke-dasharray: 89, 200; stroke-dashoffset: -35px; }
  100% { stroke-dasharray: 89, 200; stroke-dashoffset: -124px; }
}
