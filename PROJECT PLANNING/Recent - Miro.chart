ct__option--destructive-action:hover { color: var(--colors-text-danger); }

.rtb-select__option:not(.rtb-select__option--disabled, [disabled]).rtb-sele=
ct__option--destructive-action:active { color: var(--colors-text-danger-hov=
er); }

.rtb-select__option[disabled], .rtb-select__option.rtb-select__option--disa=
bled { color: var(--colors-black); opacity: 0.4; cursor: default; }

.rtb-select__option > img { width: 24px; height: 24px; min-width: 24px; max=
-width: 24px; min-height: 24px; max-height: 24px; overflow: hidden; margin-=
right: 12px; border-radius: 2px; vertical-align: middle; }

.rtb-select__option .option-icon { width: 24px; height: 24px; min-width: 24=
px; max-width: 24px; min-height: 24px; max-height: 24px; overflow: hidden; =
margin-right: 16px; }

.rtb-select__option .option-checkmark { width: 24px; height: 24px; min-widt=
h: 24px; max-width: 24px; min-height: 24px; max-height: 24px; overflow: hid=
den; color: var(--colors-text-primary); margin-left: 4px; }

.rtb-select__option--with-tag { position: relative; }

.rtb-select__tag { position: absolute; right: 8px; top: 9px; }

.rtb-select__divider { display: block; width: 100%; border-bottom: 1px soli=
d var(--colors-gray-150); margin: 8px 0px; }

.rtb-select__virtual-list { min-width: 150px; }

.rtb-select-label { display: block; margin-bottom: 6px; font-size: 13px; co=
lor: rgb(74, 74, 74); }

.rtb-select-option-removal { position: absolute; right: 0px; display: flex;=
