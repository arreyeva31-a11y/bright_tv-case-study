rm: translateY(-58px); opacity: 0; transition: opacity 0.2s ease-out, trans=
form 0.2s ease-out; }

.notification-container.notification-container--bottom { top: unset; bottom=
: 8px; transform: translateY(58px); }

.notification-container.notification-container--medium-bottom { top: unset;=
 bottom: 55px; transform: translateY(58px); }

.notification-container.notification-container--visible { transform: transl=
ateY(0px); opacity: 1; }

.notification-container.notification-container--header-offset { top: 24px; =
z-index: 4000; }

.board-notification-host { position: absolute; inset: 0px; pointer-events: =
none; }

.board-notification-host .notification-container { position: absolute; widt=
h: 100%; }
